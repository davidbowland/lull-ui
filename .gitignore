# Node artifact files
# No trailing slash on node_modules: parallel-agent worktrees symlink it rather
# than reinstalling, and a trailing slash only matches directories, so `git add -A`
# in a worktree would stage the symlink.
node_modules
dist/
coverage/

# Next.js
out/
.next/
.swc/

# AWS SAM
.aws-sam/

# Generated artifacts (next-sitemap output) — the Common Threads brand assets
# below are checked in on purpose, see scripts/generate-favicons.js
public/*
!public/icon.svg
!public/site.webmanifest
!public/favicon-16x16.png
!public/favicon-32x32.png
!public/apple-touch-icon.png
!public/icon-192.png
!public/icon-512.png
!public/icon-maskable-512.png
!public/og-image.png
# sw.js is hand-written source, not generated. scripts/generate-sw-manifest.js only
# rewrites the copy in out/ at postbuild; this one is the input.
!public/sw.js

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Agent, editor, and incremental-build scratch
.claude/
.superpowers/
.vscode
.worktrees/
docs/
tsconfig.tsbuildinfo
